#!/usr/bin/env bash
# run_onchange_install-packages.sh.tmpl
# Hash of the package list below — changes here re-trigger the script
# packages-hash: {{ .chezmoi.data.packages | toJson | sha256sum }}

set -euo pipefail

PACMAN_PKGS="{{ .packages.base | join " " }} {{ index .packages .machine_role | join " " }}"
AUR_PKGS="{{ .packages.aur.base | join " " }}{{ if hasKey .packages.aur .machine_role }} {{ index .packages.aur .machine_role | join " " }}{{ end }}"

sudo pacman -S --needed --noconfirm $PACMAN_PKGS
yay -S --needed --noconfirm $AUR_PKGS

#!/usr/bin/env python3
# Hagalaz sysmon: prints one JSON object of system stats.
#   stats          full report for the popup
#   stats --brief  cpu/mem percentages for the bar label
import glob, json, os, shutil, subprocess, sys, time

BRIEF = "--brief" in sys.argv
SAMPLE = 0.4


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def find_nvidia_gpu():
    # First NVIDIA (vendor 0x10de) display controller (class 0x03xxxx).
    for dev in sorted(glob.glob("/sys/bus/pci/devices/*")):
        if read(dev + "/vendor") == "0x10de" and read(dev + "/class").startswith("0x03"):
            return dev
    return None


def cpu_times():
    rows = {}
    for line in read("/proc/stat").splitlines():
        if not line.startswith("cpu"):
            break
        name, *vals = line.split()
        vals = list(map(int, vals))
        idle = vals[3] + vals[4]
        rows[name] = (sum(vals[:8]), idle)
    return rows


def proc_ticks():
    ticks = {}
    for stat in glob.glob("/proc/[0-9]*/stat"):
        raw = read(stat)
        if not raw:
            continue
        # comm may contain spaces/parens; split after the last ')'
        head, _, tail = raw.rpartition(")")
        fields = tail.split()
        try:
            ticks[stat.split("/")[2]] = (head.split("(", 1)[1], int(fields[11]) + int(fields[12]))
        except (IndexError, ValueError):
            pass
    return ticks


def pct(a, b):
    total = b[0] - a[0]
    return 0.0 if total <= 0 else round(100.0 * (1 - (b[1] - a[1]) / total), 1)


def meminfo():
    info = {}
    for line in read("/proc/meminfo").splitlines():
        key, val = line.split(":", 1)
        info[key] = int(val.split()[0]) * 1024
    total, avail = info.get("MemTotal", 0), info.get("MemAvailable", 0)
    used = total - avail
    return {
        "total": total, "used": used,
        "cached": info.get("Cached", 0) + info.get("SReclaimable", 0),
        "pct": round(100.0 * used / total, 1) if total else 0,
        "swapTotal": info.get("SwapTotal", 0),
        "swapUsed": info.get("SwapTotal", 0) - info.get("SwapFree", 0),
    }


def hwmon_temp(*names):
    # First matching sensor wins, in the order given.
    sensors = {read(h + "/name"): h for h in glob.glob("/sys/class/hwmon/hwmon*")}
    for name in names:
        h = sensors.get(name)
        v = read(h + "/temp1_input") if h else ""
        if v:
            return round(int(v) / 1000)
    return None


def gpu():
    # Querying nvidia-smi wakes a runtime-suspended dGPU, so check first.
    dev = find_nvidia_gpu()
    if not dev or not shutil.which("nvidia-smi"):
        return None
    # Desktops often have no runtime PM; treat a missing status as awake.
    status = read(dev + "/power/runtime_status", "active")
    if status != "active":
        return {"asleep": True}
    try:
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=name,utilization.gpu,temperature.gpu,memory.used,memory.total,power.draw",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=3).stdout.strip()
        name, util, temp, mused, mtotal, power = [x.strip() for x in out.split(",")]
        num = lambda x: float(x) if x.replace(".", "", 1).isdigit() else None
        return {"asleep": False, "name": name.replace("NVIDIA ", ""), "util": num(util), "temp": num(temp),
                "memUsed": num(mused), "memTotal": num(mtotal), "power": num(power)}
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def disks():
    seen, result = set(), []
    for mount in ("/", "/home"):
        try:
            st = os.statvfs(mount)
        except OSError:
            continue
        key = (st.f_blocks, st.f_files)
        if key in seen:
            continue
        seen.add(key)
        total, free = st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize
        used = total - st.f_bfree * st.f_frsize
        result.append({"mount": mount, "total": total, "used": used, "pct": round(100.0 * used / total, 1) if total else 0})
    return result


t0 = cpu_times()
p0 = None if BRIEF else proc_ticks()
time.sleep(SAMPLE)
t1 = cpu_times()
mem = meminfo()
cpu_pct = pct(t0["cpu"], t1["cpu"])

if BRIEF:
    print(json.dumps({"cpu": cpu_pct, "mem": mem["pct"]}))
    sys.exit(0)

p1 = proc_ticks()
cores = [pct(t0[k], t1[k]) for k in sorted((k for k in t1 if k != "cpu"), key=lambda k: int(k[3:])) if k in t0]
hz = os.sysconf("SC_CLK_TCK")
ncpu = max(1, len(cores))
procs = []
for pid, (comm, ticks) in p1.items():
    if pid in p0 and p0[pid][0] == comm:
        usage = (ticks - p0[pid][1]) / hz / SAMPLE * 100.0
        if usage > 0:
            procs.append({"pid": int(pid), "name": comm, "cpu": round(usage / ncpu, 1)})
procs.sort(key=lambda p: -p["cpu"])

print(json.dumps({
    "cpu": {"pct": cpu_pct, "cores": cores, "temp": hwmon_temp("coretemp", "k10temp", "zenpower", "acpitz"),
            "load": read("/proc/loadavg").split()[:3]},
    "mem": mem,
    "gpu": gpu(),
    "disks": disks(),
    "nvmeTemp": hwmon_temp("nvme"),
    "uptime": int(float(read("/proc/uptime", "0").split()[0])),
    "procs": procs[:5],
}))

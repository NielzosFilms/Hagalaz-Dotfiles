{
  "bar": {
    "centerAnchor": "niels.clock",
    "layout": {
      "left": [
        {
          "id": "local.rune-workspaces"
        },
        {
          "id": "niels.media"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "local.hagalaz-moon"
        },
        {
          "id": "niels.clock",
          "format": "HH:mm",
          "formatAlt": "ddd d MMM 'W'ww",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "local.hagalaz-pomodoro",
          "workMinutes": 25,
          "breakMinutes": 5
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "local.hagalaz-sysmon"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1,
  "disabledPlugins": [
    "omarchy.media"
  ],
  "cloneSourceRestores": [
    "niels.media"
  ]
